# Normalize line endings: LF in the repository and in working copies, on every OS.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.mp4  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.zip  binary
